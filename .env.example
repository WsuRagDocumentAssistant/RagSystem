# ── 서버 ──────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ── 외부 AI API 키 ─────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── PostgreSQL (rag-system/rag-postgres-secret) ─
DB_USER=
DB_PASSWORD=

# ── 학교 Oracle DB 뷰 (rag-system/rag-app-secret) ─
# 타이머가 WS_VIEW.AIKEY_USER_V 를 PostgreSQL 사본(school_users)으로 복사할 때만 쓴다.
# false 면 복사만 멈추고, 관리자 화면은 마지막 사본으로 동작한다.
SCHOOL_SYNC_ENABLED=false
# 복사 주기(분). 기본 60
RAG_SCHOOL_SYNC_MINUTES=60
SCHOOL_ORACLE_HOST=
SCHOOL_ORACLE_PORT=1521
SCHOOL_ORACLE_SERVICE_NAME=
SCHOOL_ORACLE_USER=
SCHOOL_ORACLE_PASSWORD=
SCHOOL_ORACLE_OWNER=
