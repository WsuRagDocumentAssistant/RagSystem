# ── 서버 ──────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ── 외부 AI API 키 ─────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── PostgreSQL (rag-system/rag-postgres-secret) ─
DB_USER=
DB_PASSWORD=

# ── 학교 Oracle DB 뷰 (rag-system/rag-app-secret) ─
# 관리자 화면의 소속 표시·사용자 검색(WS_VIEW.AIKEY_USER_V)에 쓴다. false 면 그 기능만 빈다.
SCHOOL_SYNC_ENABLED=false
SCHOOL_ORACLE_HOST=
SCHOOL_ORACLE_PORT=1521
SCHOOL_ORACLE_SERVICE_NAME=
SCHOOL_ORACLE_USER=
SCHOOL_ORACLE_PASSWORD=
SCHOOL_ORACLE_OWNER=
